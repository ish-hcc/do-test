# 시험 환경 설정. 비밀번호·키는 여기에 쓰지 않는다.
# 스크립트는 이 파일을 source 한다. 실행할 때 env 로 덮어써도 된다 (예: SRC_VCPU=4 scripts/...).

# --- VM 을 만드는 쪽 tumblebug (부트스트랩) ---
# 로컬 ~/go/src/cloud-migrator/cb-tumblebug 을 단독 compose 로 띄운 것 (v0.13.8, 11-03 에 init 완료)
BOOT_TB_URL=${BOOT_TB_URL:-http://localhost:1323/tumblebug}
BOOT_TB_CONTAINER=${BOOT_TB_CONTAINER:-cb-tumblebug}   # API 계정을 이 컨테이너 env 에서 읽는다

# --- Source VM 이 놓일 곳 ---
SRC_CSP=${SRC_CSP:-aws}
SRC_REGION=${SRC_REGION:-ap-northeast-2}
SRC_OS=${SRC_OS:-ubuntu 22.04}            # grasshopper 설치 스크립트가 Ubuntu 22.04 기준
SRC_ARCH=${SRC_ARCH:-x86_64}
# 이미지를 고정하려면 tumblebug image id 를 넣는다. 비우면 searchImage 로 기본 이미지(isBasicImage) 중 하나를 고른다
SRC_IMAGE_ID=${SRC_IMAGE_ID:-}

# --- Source VM 스펙 (수집 대상·이관 대상 전부 같은 nodeGroup 이라 하나로 둔다) ---
SRC_VCPU=${SRC_VCPU:-8}
SRC_MEM_GIB=${SRC_MEM_GIB:-16}
SRC_DISK_GB=${SRC_DISK_GB:-50}

# --- CM 플랫폼 VM 스펙 ---
CM_VCPU=${CM_VCPU:-16}
CM_MEM_GIB=${CM_MEM_GIB:-32}
CM_DISK_GB=${CM_DISK_GB:-200}

# --- tumblebug 이름 ---
CM_NS=${CM_NS:-cmplatform}
CM_INFRA=${CM_INFRA:-cm}
NS_ONPREM=${NS_ONPREM:-onpremise}         # honeybee 를 SSH 방식(type onprem)으로 등록
NS_CSP=${NS_CSP:-csp}                     # honeybee 를 cb-spider lib 방식(type csp)으로 등록
SRC_INFRA=${SRC_INFRA:-source}
SRC_NODEGROUP=${SRC_NODEGROUP:-g1}        # 노드 이름은 g1-1, g1-2 ... (config/source-vms.conf 의 idx 순서)

# --- 접근 허용 ---
# CM VM 의 API 포트를 열어 줄 CIDR. 비우면 실행 시점의 내 공인 IP/32 를 쓴다.
ADMIN_CIDR=${ADMIN_CIDR:-}
CM_API_PORTS=${CM_API_PORTS:-"80 1323 1024 1324 8056 8081 8083 8084 8088 8080 8880"}

# --- cm-mayfly ---
MAYFLY_REPO=${MAYFLY_REPO:-https://github.com/cloud-barista/cm-mayfly.git}
MAYFLY_REF=${MAYFLY_REF:-main}
CM_HOME=${CM_HOME:-/home/cb-user/cm-mayfly}   # CM VM 안의 경로

# --- tumblebug init ---
TB_SRC=${TB_SRC:-$HOME/go/src/cloud-migrator/cb-tumblebug}   # init 을 돌릴 소스 (versions.env 의 태그로 맞춘다)
CRED_DIR=${CRED_DIR:-$HOME/.cloud-barista}
INIT_OPTION=${INIT_OPTION:-c}             # c = Azure 포함 전체 CSP 에서 새로 가져오기

# --- 마이그레이션 대상 ---
MIG_NS=${MIG_NS:-mig01}
TARGET_CSPS=${TARGET_CSPS:-"aws azure gcp alibaba tencent nhn ncp kt"}
# 리전 이름은 tumblebug assets/cloudinfo.yaml 기준 (2026-11-05 확인)
TARGET_REGION_aws=${TARGET_REGION_aws:-ap-northeast-2}
TARGET_REGION_azure=${TARGET_REGION_azure:-koreacentral}
TARGET_REGION_gcp=${TARGET_REGION_gcp:-asia-northeast3}
TARGET_REGION_alibaba=${TARGET_REGION_alibaba:-ap-northeast-2}
TARGET_REGION_tencent=${TARGET_REGION_tencent:-ap-seoul}
TARGET_REGION_nhn=${TARGET_REGION_nhn:-KR1}
TARGET_REGION_ncp=${TARGET_REGION_ncp:-KR}
TARGET_REGION_kt=${TARGET_REGION_kt:-KR1}

# --- 실행 기록을 남길 곳 (git 밖. .git/info/exclude 에 들어 있다) ---
RUN_DIR=${RUN_DIR:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)/.claude/run}
