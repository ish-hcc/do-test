# 모듈별 이미지 태그. scripts/apply-versions.sh 가 cm-mayfly 의
# conf/docker/docker-compose.yaml 에서 `image: cloudbaristaorg/<이름>:<태그>` 줄을 이 값으로 바꾼다.
# 키 이름은 이미지 이름의 '-' 를 '_' 로, 대문자로 바꾼 것이다 (cm-honeybee -> CM_HONEYBEE).
# 비워 두면 compose 에 적힌 값을 그대로 둔다.

# cb-tumblebug 은 사용자가 정한 기준 버전이다 (2026-11-05).
# init 에 쓰는 cb-tumblebug 소스도 이 태그(v 접두사)로 맞춘다.
CB_TUMBLEBUG=0.13.8
# tumblebug v0.13.8 의 docker-compose.yaml 이 함께 쓰는 버전 (2026-11-03 세션 기록)
CB_SPIDER=0.13.20
CB_MAPUI=0.13.14
# 아래는 2026-11-05 기준 cm-mayfly compose 에 적힌 값 그대로다.
MC_TERRARIUM=0.1.4
CM_BEETLE=0.6.0
CM_BUTTERFLY_API=0.6.0
CM_BUTTERFLY_FRONT=0.6.0
# CSP(cb-spider lib) 수집과 RDBMS 수집은 릴리즈 태그(v0.6.3 까지)에 없고 main 에만 있다
# (2026-11-05 확인: v0.6.3 에 server/pkg/api/rest/route/csp.go 가 없음).
# HONEYBEE_BUILD_REF 를 채우면 CM VM 에서 그 ref 를 빌드해 cloudbaristaorg/cm-honeybee:<CM_HONEYBEE> 로 태그한다.
# 비우면 Docker Hub 의 cloudbaristaorg/cm-honeybee:<CM_HONEYBEE> 를 받는다.
CM_HONEYBEE=main-build
HONEYBEE_BUILD_REF=main
HONEYBEE_REPO=https://github.com/cloud-barista/cm-honeybee.git
CM_DAMSELFLY=0.6.2
CM_CICADA=0.6.1
AIRFLOW_SERVER=0.6.1
CM_GRASSHOPPER=0.6.0
CM_ANT=0.6.0
